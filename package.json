{
  "name": "crypto-lab-attribute-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser lessons for FAME, FABESA, RW15 multi-authority ABE, and bounded epoch rewrap over BLS12-381.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test --project=a11y",
    "test:claims": "playwright test --project=claims",
    "test:e2e": "playwright test",
    "vectors:update": "UPDATE_VECTORS=1 vitest run src/fame/vectors.test.ts",
    "test:mutations": "node scripts/mutations.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
